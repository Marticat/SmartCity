# Copy to .env. Server secrets never belong in VITE_* variables.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
ORS_API_KEY=
WEATHER_ENABLED=true
FRONTEND_ORIGIN=http://localhost:5173
# Local paths are resolved from the project; Docker sets DATA_DIR separately.
# DATA_DIR=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=main
# Public, build-time settings. Rebuild frontend after changes. Never put keys here.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
